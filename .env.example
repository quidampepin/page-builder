# Get a key from https://console.anthropic.com/ → API Keys
# Copy this file to .env.local and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use for chat (page generation, edit ops). Default is
# claude-sonnet-4-6 — good balance of speed and quality. Swap to
# claude-opus-4-6 for maximum quality on complex pages, or to
# claude-haiku-4-5-20251001 for fastest responses.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Which model to use for the translate route. Defaults to Haiku because
# translate is a structure-preserving text swap that doesn't need a
# reasoning-heavy model, and full-page translates can otherwise bump
# up against Vercel Hobby's 60s function timeout. Override only if you
# want a different model just for translation.
# ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5-20251001

# Which LLM adapter to load (future-proofing for other providers).
# Only "anthropic" is wired up in v1.
LLM_PROVIDER=anthropic

# Optional HTTP basic-auth gate for Vercel deployments.
# If both vars are set, every request must carry valid Basic auth or
# the browser's native sign-in dialog appears. Leave both UNSET (or
# don't define them) to disable the gate — that's the recommended
# setup for local dev so `npm run dev` doesn't prompt.
# Set them on Vercel via Project Settings → Environment Variables.
# BASIC_AUTH_USER=david
# BASIC_AUTH_PASS=replace-with-something-strong
